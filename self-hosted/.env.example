# Salin file ini menjadi `.env` di folder self-hosted/ lalu sesuaikan.

# URL publik backend Convex (dipakai oleh client / VITE_CONVEX_URL).
# Di VPS produksi, ganti dengan domain HTTPS Anda, mis. https://convex.domain-anda.com
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210

# URL publik untuk HTTP actions & auth (port 3211).
# Di VPS produksi, mis. https://convex-site.domain-anda.com
CONVEX_SITE_ORIGIN=http://127.0.0.1:3211

# URL yang dibuka dashboard untuk mengakses backend (biasanya sama dengan CONVEX_CLOUD_ORIGIN).
NEXT_PUBLIC_DEPLOYMENT_URL=http://127.0.0.1:3210

# Nama & secret instance (opsional untuk dev; WAJIB diisi untuk produksi
# agar admin key stabil). Buat secret acak: openssl rand -hex 32
INSTANCE_NAME=dapur-laut
INSTANCE_SECRET=

# Nonaktifkan telemetri beacon (opsional)
DISABLE_BEACON=true
